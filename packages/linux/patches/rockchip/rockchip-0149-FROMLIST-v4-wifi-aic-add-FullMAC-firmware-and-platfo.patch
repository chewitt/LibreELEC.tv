+static void parse_ssid_from_id(const u8 *ssid_id, char ssid_name[33], u8 *ssid_len)
+{
+	u8 len;
+
+	if (!ssid_id)
+		return;
+
+	len = *(ssid_id + 1);
+	if (len > 32)
+		len = 32;
+
+	strscpy(ssid_name, ssid_id + 2, len);
+	ssid_name[len] = '\0';
+	*ssid_len = len;
+
+	if (len > 0)
+		AICWFDBG(LOGDEBUG, "find_ccode ssid: %s\n", ssid_name);
+	else
+		AICWFDBG(LOGDEBUG, "find_ccode ssid is null\n");
+}
