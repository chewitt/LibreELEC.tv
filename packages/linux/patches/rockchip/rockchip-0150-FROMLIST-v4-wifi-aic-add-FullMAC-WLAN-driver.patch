+void aicwf_rxframe_queue_init_2(struct rx_frame_queue *pq, int max_len)
+{
+	memset(pq, 0,
+	       offsetof(struct rx_frame_queue, queuelist) +
+	       (sizeof(struct list_head)));
+	pq->qmax = (u16)max_len;
+	INIT_LIST_HEAD(&pq->queuelist);
