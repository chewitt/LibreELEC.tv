+	wake_cnt++;
+
+	/* One-shot OOB wake event; it is not a paired SDIO activity unit. */
+	__pm_wakeup_event(g_rwnx_plat->sdiodev->rwnx_hw->ws_rx, 1000);
+
+	AICWFDBG(LOGIRQ, "%s(%d): wake_irq_cnt = %d\n", __func__, __LINE__,
