+static int __maybe_unused rwnx_cfg80211_add_mpath(struct wiphy *wiphy,
+					 struct net_device *dev,
+				   const u8 *dst, const u8 *next_hop)
+{
+	struct rwnx_vif *rwnx_vif = netdev_priv(dev);
+	struct rwnx_hw *rwnx_hw = wiphy_priv(wiphy);
