 hal/phydm/phydm_debug.c       |  5 ++++
 os_dep/linux/ioctl_cfg80211.c |  8 ++++++
 os_dep/linux/ioctl_linux.c    | 12 +++++++++
 os_dep/linux/os_intfs.c       |  4 +++
 os_dep/linux/rtw_cfgvendor.c  | 16 +++++++++---
 10 files changed, 112 insertions(+), 5 deletions(-)

