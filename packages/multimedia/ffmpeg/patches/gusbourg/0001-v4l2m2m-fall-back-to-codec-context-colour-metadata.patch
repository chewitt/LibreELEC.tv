From d128a365c5bb5d2be5a3bd2cfdc00adc29928444 Mon Sep 17 00:00:00 2001
From: Gus Bourg <gus@bourg.net>
Date: Wed, 2 Sep 2026 17:30:00 -0700
Subject: [PATCH 1/3] v4l2m2m: fall back to codec-context colour metadata

Signed-off-by: Gus Bourg <gus@bourg.net>
---
 libavcodec/v4l2_buffers.c | 45 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/libavcodec/v4l2_buffers.c b/libavcodec/v4l2_buffers.c
index ff5ff86090..1364d123a7 100644
--- a/libavcodec/v4l2_buffers.c
+++ b/libavcodec/v4l2_buffers.c
@@ -893,6 +893,51 @@ int ff_v4l2_buffer_buf_to_avframe(AVFrame *frame, V4L2Buffer *avbuf)
     frame->colorspace = v4l2_get_color_space(avbuf);
     frame->color_range = v4l2_get_color_range(avbuf);
     frame->color_trc = v4l2_get_color_trc(avbuf);
+
+    /*
+     * meson-vdec (and other stateful decoders) report the CAPTURE queue
+     * colorspace as DEFAULT because nothing programs it on the OUTPUT
+     * side for decode, so the getters above come back UNSPECIFIED.  Fall
+     * back to the codec context's colour properties (parsed from the
+     * container/bitstream by lavf/lavc) and propagate the static HDR
+     * side data, so downstream consumers such as Kodi's HDR passthrough
+     * see PQ/BT.2020 plus mastering metadata on HDR streams.
+     */
+    {
+        const AVCodecContext * const avctx = buf_to_m2mctx(avbuf)->avctx;
+
+        if (avctx) {
+            int i;
+
+            if (frame->color_primaries == AVCOL_PRI_UNSPECIFIED)
+                frame->color_primaries = avctx->color_primaries;
+            if (frame->colorspace == AVCOL_SPC_UNSPECIFIED)
+                frame->colorspace = avctx->colorspace;
+            if (frame->color_range == AVCOL_RANGE_UNSPECIFIED)
+                frame->color_range = avctx->color_range;
+            if (frame->color_trc == AVCOL_TRC_UNSPECIFIED)
+                frame->color_trc = avctx->color_trc;
+
+            for (i = 0; i < avctx->nb_coded_side_data; i++) {
+                const AVPacketSideData * const sd = &avctx->coded_side_data[i];
+                enum AVFrameSideDataType fsd;
+
+                if (sd->type == AV_PKT_DATA_MASTERING_DISPLAY_METADATA)
+                    fsd = AV_FRAME_DATA_MASTERING_DISPLAY_METADATA;
+                else if (sd->type == AV_PKT_DATA_CONTENT_LIGHT_LEVEL)
+                    fsd = AV_FRAME_DATA_CONTENT_LIGHT_LEVEL;
+                else
+                    continue;
+
+                if (!av_frame_get_side_data(frame, fsd)) {
+                    AVFrameSideData * const nsd =
+                        av_frame_new_side_data(frame, fsd, sd->size);
+                    if (nsd)
+                        memcpy(nsd->data, sd->data, sd->size);
+                }
+            }
+        }
+    }
     frame->pts = v4l2_get_pts(avbuf);
     frame->pkt_dts = AV_NOPTS_VALUE;
     frame_set_interlace(frame, v4l2_buf_is_interlaced(avbuf), v4l2_buf_is_top_first(avbuf));
-- 
