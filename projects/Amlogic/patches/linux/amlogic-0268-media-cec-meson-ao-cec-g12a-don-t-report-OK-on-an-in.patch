From 6f01aeca80eced52596a08dbeba7ae847f6ef0db Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Tue, 24 Nov 2026 17:28:03 +0000
Subject: [PATCH 268/269] media: cec: meson: ao-cec-g12a: don't report OK on an
 initiator error

The CECB controller can raise DONE and INITIATOR_ERR in the same
interrupt. The IRQ thread reports DONE first as CEC_TX_STATUS_OK, so the
CEC core completes the transmit as acknowledged and drops the following
CEC_TX_STATUS_ERROR ("cec_transmit_done_ts was called without an ongoing
transmit"). A poll that never reached the bus is then seen as ACKed, the
logical address is treated as taken, and claiming an address fails.

Report CEC_TX_STATUS_ERROR when INITIATOR_ERR is set, and OK only for
DONE without an error, so the core retries the transmit.

Fixes: b7778c46683c ("media: platform: meson: Add Amlogic Meson G12A AO CEC Controller driver")
Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 drivers/media/cec/platform/meson/ao-cec-g12a.c | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/drivers/media/cec/platform/meson/ao-cec-g12a.c b/drivers/media/cec/platform/meson/ao-cec-g12a.c
index b175be3f2bf4..02a2a3f7960e 100644
--- a/drivers/media/cec/platform/meson/ao-cec-g12a.c
+++ b/drivers/media/cec/platform/meson/ao-cec-g12a.c
@@ -470,7 +470,10 @@ static irqreturn_t meson_ao_cec_g12a_irq_thread(int irq, void *data)
 	regmap_read(ao_cec->regmap, CECB_INTR_STAT_REG, &stat);
 	regmap_write(ao_cec->regmap, CECB_INTR_CLR_REG, stat);
 
-	if (stat & CECB_INTR_DONE)
+	/* DONE can be raised together with INITIATOR_ERR */
+	if (stat & CECB_INTR_INITIATOR_ERR)
+		cec_transmit_attempt_done(ao_cec->adap, CEC_TX_STATUS_ERROR);
+	else if (stat & CECB_INTR_DONE)
 		cec_transmit_attempt_done(ao_cec->adap, CEC_TX_STATUS_OK);
 
 	if (stat & CECB_INTR_EOM)
@@ -486,10 +489,6 @@ static irqreturn_t meson_ao_cec_g12a_irq_thread(int irq, void *data)
 		cec_transmit_attempt_done(ao_cec->adap, CEC_TX_STATUS_ARB_LOST);
 	}
 
-	/* Initiator reports an error on the CEC bus */
-	if (stat & CECB_INTR_INITIATOR_ERR)
-		cec_transmit_attempt_done(ao_cec->adap, CEC_TX_STATUS_ERROR);
-
 	/* Follower reports a receive error, just reset RX buffer */
 	if (stat & CECB_INTR_FOLLOWER_ERR)
 		regmap_write(ao_cec->regmap_cec, CECB_LOCK_BUF, 0);
-- 
