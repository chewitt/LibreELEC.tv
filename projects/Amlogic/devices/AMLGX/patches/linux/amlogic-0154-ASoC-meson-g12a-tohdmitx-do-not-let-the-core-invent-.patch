From f2549da5f5aa61b8f7c0535ccf435fb93392c8f3 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Thu, 17 Sep 2026 07:39:29 +0000
Subject: [PATCH 154/177] ASoC: meson: g12a-tohdmitx: do not let the core
 invent a slot mask

The TDM interface spreads its slots over four lanes, and the card driver
hands the codecs of the link the per-lane slot count.  A codec that
declares no slot mask in the device tree has one invented from that count
by snd_soc_dai_set_tdm_slot(), so the glue inputs come out with a two
slot mask, and __soc_pcm_hw_params() then pins the channel count they are
given to the weight of that mask.

The stream reaches the HDMI transmitter through the glue, so six and
eight channel streams were described to it as two channel.  The samples
went out over all of the lanes, while the channel count, the channel
allocation and so the audio infoframe announced stereo, leaving the sink
to play a multichannel stream as two channels.

Provide an xlate_tdm_slot_mask() that leaves the masks as they are, so a
mask from the device tree is still honoured and none is invented where
the device tree gives none.

Assisted-by: Claude:claude-opus-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 sound/soc/meson/g12a-tohdmitx.c | 22 ++++++++++++++++++----
 1 file changed, 18 insertions(+), 4 deletions(-)

diff --git a/sound/soc/meson/g12a-tohdmitx.c b/sound/soc/meson/g12a-tohdmitx.c
index 967109ca2b57..1fb81fc29446 100644
--- a/sound/soc/meson/g12a-tohdmitx.c
+++ b/sound/soc/meson/g12a-tohdmitx.c
@@ -126,6 +126,19 @@ static const struct snd_kcontrol_new g12a_tohdmitx_spdif_mux =
 			  snd_soc_dapm_get_enum_double,
 			  g12a_tohdmitx_spdif_mux_put_enum);
 
+static int g12a_tohdmitx_xlate_tdm_slot_mask(unsigned int slots,
+					     unsigned int *tx_mask,
+					     unsigned int *rx_mask)
+{
+	/*
+	 * The interface spreads its slots over four lanes, so the slot count
+	 * is per lane and a mask derived from it would describe one lane.
+	 * The glue carries the whole stream, so keep the masks the device
+	 * tree gave and ask for none where it gave nothing.
+	 */
+	return 0;
+}
+
 static const struct snd_kcontrol_new g12a_tohdmitx_out_enable =
 	SOC_DAPM_SINGLE_AUTODISABLE("Switch", TOHDMITX_CTRL0,
 				    CTRL0_ENABLE_SHIFT, 1, 0);
@@ -142,10 +155,11 @@ static const struct snd_soc_dapm_widget g12a_tohdmitx_widgets[] = {
 };
 
 static const struct snd_soc_dai_ops g12a_tohdmitx_input_ops = {
-	.probe		= meson_codec_glue_input_dai_probe,
-	.remove		= meson_codec_glue_input_dai_remove,
-	.hw_params	= meson_codec_glue_input_hw_params,
-	.set_fmt	= meson_codec_glue_input_set_fmt,
+	.probe			= meson_codec_glue_input_dai_probe,
+	.remove			= meson_codec_glue_input_dai_remove,
+	.hw_params		= meson_codec_glue_input_hw_params,
+	.set_fmt		= meson_codec_glue_input_set_fmt,
+	.xlate_tdm_slot_mask	= g12a_tohdmitx_xlate_tdm_slot_mask,
 };
 
 static const struct snd_soc_dai_ops g12a_tohdmitx_output_ops = {
-- 
