From 7149b0cd7c0f3d810dcc48e4243b41cd9ee02ccb Mon Sep 17 00:00:00 2001
From: Gus Bourg <gus@bourg.net>
Date: Wed, 2 Sep 2026 17:30:00 -0700
Subject: [PATCH 061/145] media: meson: vdec: emit the initial SOURCE_CHANGE
 event for mpeg12

The stateful-decoder UAPI has the client wait for V4L2_EVENT_SOURCE_CHANGE
before configuring the CAPTURE queue, after the decoder has seen the
stream headers.  The h264/hevc/vp9 codecs emit it from their firmware
header-parse interrupt, but mpeg12 has no such notification and never
emitted the event - while the driver in turn waits for CAPTURE streamon
before starting these no-resume-op codecs.  A spec-flow client (ffmpeg's
stateful v4l2m2m, and therefore Kodi) parks forever in this mutual wait;
GStreamer only works because it configures CAPTURE from its own parser
without waiting.

The client cannot be answered from S_FMT(OUTPUT) dimensions either:
ffmpeg deliberately sets none and expects the decoder to know better.

So know better: the MPEG1/2 sequence header is trivial to parse (start
code 00 00 01 B3, then 12-bit width and height) and is guaranteed at
stream start.  Scan the first queued OUTPUT buffers for it, take the
coded size, and queue the initial SOURCE_CHANGE event.

Validated: ffmpeg mpeg2_v4l2m2m/mpeg1_v4l2m2m now decode (previously
AVERROR_BUG after capture-poll timeouts), PSNR vs software decode
61.5 dB (MPEG-2) / 60.9 dB (MPEG-1) on 1080p clips, and Kodi plays
DVD/VCD/broadcast MPEG material with hardware decode for the first
time.  GStreamer regression: unchanged (bit-exact H.264, known-tail
VP9/MPEG behavior identical).

Signed-off-by: Gus Bourg <gus@bourg.net>
---
 drivers/staging/media/meson/vdec/vdec.c | 63 +++++++++++++++++++++++++
 drivers/staging/media/meson/vdec/vdec.h |  1 +
 2 files changed, 64 insertions(+)

diff --git a/drivers/staging/media/meson/vdec/vdec.c b/drivers/staging/media/meson/vdec/vdec.c
index d169100239c0..9018d3c26ca8 100644
--- a/drivers/staging/media/meson/vdec/vdec.c
+++ b/drivers/staging/media/meson/vdec/vdec.c
@@ -259,6 +259,61 @@ static int vdec_queue_setup(struct vb2_queue *q, unsigned int *num_buffers,
 	return 0;
 }
 
+/*
+ * MPEG1/2 sequence header: start code 00 00 01 B3 followed by
+ * horizontal_size (12 bits) and vertical_size (12 bits).
+ *
+ * The mpeg12 firmware has no header-parse notification, so the initial
+ * SOURCE_CHANGE event a spec-flow stateful client (ffmpeg) waits for
+ * before configuring the CAPTURE queue would never fire, parking the
+ * session in a mutual wait.  Scan the queued bitstream for the sequence
+ * header and answer with the real coded size.
+ */
+static bool vdec_parse_mpeg_seq_header(struct amvdec_session *sess,
+				       struct vb2_buffer *vb)
+{
+	const u8 *data = vb2_plane_vaddr(vb, 0);
+	u32 len = vb2_get_plane_payload(vb, 0);
+	u32 i, w, h;
+
+	if (!data)
+		return false;
+
+	for (i = 0; i + 6 < len; i++) {
+		if (data[i] != 0x00 || data[i + 1] != 0x00 ||
+		    data[i + 2] != 0x01 || data[i + 3] != 0xb3)
+			continue;
+
+		w = (data[i + 4] << 4) | (data[i + 5] >> 4);
+		h = ((data[i + 5] & 0xf) << 8) | data[i + 6];
+		if (!w || !h)
+			return false;
+
+		sess->width = w;
+		sess->height = h;
+		dev_dbg(sess->core->dev, "mpeg seq header: %ux%u\n", w, h);
+		return true;
+	}
+
+	return false;
+}
+
+static void vdec_init_src_change(struct amvdec_session *sess,
+				 struct vb2_buffer *vb)
+{
+	static const struct v4l2_event ev = {
+		.type = V4L2_EVENT_SOURCE_CHANGE,
+		.u.src_change.changes = V4L2_EVENT_SRC_CH_RESOLUTION };
+
+	if (!vdec_parse_mpeg_seq_header(sess, vb))
+		return;
+
+	v4l2_ctrl_s_ctrl(sess->ctrl_min_buf_capture,
+			 sess->fmt_out->min_buffers);
+	v4l2_event_queue_fh(&sess->fh, &ev);
+	sess->init_src_change_done = 1;
+}
+
 static void vdec_vb2_buf_queue(struct vb2_buffer *vb)
 {
 	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
@@ -267,6 +322,11 @@ static void vdec_vb2_buf_queue(struct vb2_buffer *vb)
 
 	v4l2_m2m_buf_queue(m2m_ctx, vbuf);
 
+	if (vb->type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE &&
+	    !sess->fmt_out->codec_ops->resume &&
+	    !sess->init_src_change_done)
+		vdec_init_src_change(sess, vb);
+
 	if (!sess->streamon_out)
 		return;
 
@@ -433,6 +493,9 @@ static void vdec_stop_streaming(struct vb2_queue *q)
 		sess->status = STATUS_STOPPED;
 	}
 
+	if (q->type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE)
+		sess->init_src_change_done = 0;
+
 	if (q->type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE) {
 		while ((buf = v4l2_m2m_src_buf_remove(sess->m2m_ctx)))
 			v4l2_m2m_buf_done(buf, VB2_BUF_STATE_ERROR);
diff --git a/drivers/staging/media/meson/vdec/vdec.h b/drivers/staging/media/meson/vdec/vdec.h
index ca8a872bcf9d..a0b515ad1b11 100644
--- a/drivers/staging/media/meson/vdec/vdec.h
+++ b/drivers/staging/media/meson/vdec/vdec.h
@@ -259,6 +259,7 @@ struct amvdec_session {
 	unsigned int keyframe_found;
 	unsigned int num_dst_bufs;
 	unsigned int changed_format;
+	unsigned int init_src_change_done;
 
 	u8 canvas_alloc[MAX_CANVAS];
 	u32 canvas_num;
-- 
