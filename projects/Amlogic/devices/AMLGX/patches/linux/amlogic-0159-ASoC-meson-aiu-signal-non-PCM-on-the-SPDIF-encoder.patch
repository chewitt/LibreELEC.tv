From a4aa69ff90fede40fbe585d695ed8edae010ad7c Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Mon, 14 Sep 2026 16:38:01 +0000
Subject: [PATCH 159/177] ASoC: meson: aiu: signal non-PCM on the SPDIF encoder

The SPDIF encoder always tells the receiver it is sending linear PCM.
The channel status word is built by
snd_pcm_create_iec958_consumer_hw_params(), which constructs all four
bytes from the hardware parameters alone, so byte 0 comes back with the
non-audio bit clear whatever the stream is.  Nothing carried the
information either: no part of the AIU exposes an IEC958 Playback
Default control, so userspace had no way to say a stream is compressed.

Add that control alongside its mask, seeded at probe, and take the
channel status from it - snd_pcm_fill_iec958_consumer() fills in the
sample rate and word length while leaving byte 0 alone.

Drive the validity flag from the same bit.  It says the samples of a
frame are not suitable for conversion to analogue, which is true of a
compressed stream, and the encoder leaves it clear for every stream
today.  AIU_958_VALID_CTRL holds an enable in bit 1 and the value the
encoder drives in bit 0, so a non-PCM stream wants both set and a PCM
stream wants the control left disabled.  That is what the vendor driver
writes, in audio_set_958_mode() and alongside a channel status of
0x1902.

Apply it at prepare rather than at hw_params.  The ctl_elems hook that
alsa-lib's iec958 device uses to set the control runs after the slave's
hw_params has returned, and only prepare follows it, so a channel status
latched in hw_params always carries the previous value rather than the
one userspace asked for.

It belongs to the encoder rather than to a PCM, so it is a component
control and carries the card's name prefix.  That keeps it clear of the
internal PCM device numbering that makes the HDMI codec's controls hard
to address, and gives it the same name on every board of the family.

AIU_958_MISC bit 0 is deliberately not set with it.  That bit belongs to
the encoder's raw framing mode, which consumes a raw codec bitstream
rather than the already framed IEC61937 an ALSA passthrough stream
carries, and setting it breaks playback.

Assisted-by: Claude:claude-opus-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 sound/soc/meson/aiu-encoder-spdif.c | 42 +++++++++++++----
 sound/soc/meson/aiu.c               | 72 +++++++++++++++++++++++++++++
 sound/soc/meson/aiu.h               |  4 ++
 3 files changed, 108 insertions(+), 10 deletions(-)

diff --git a/sound/soc/meson/aiu-encoder-spdif.c b/sound/soc/meson/aiu-encoder-spdif.c
index 5d654e17c45f..70f5684ef4f1 100644
--- a/sound/soc/meson/aiu-encoder-spdif.c
+++ b/sound/soc/meson/aiu-encoder-spdif.c
@@ -5,6 +5,7 @@
 
 #include <linux/bitfield.h>
 #include <linux/clk.h>
+#include <sound/asoundef.h>
 #include <sound/pcm_params.h>
 #include <sound/pcm_iec958.h>
 #include <sound/soc.h>
@@ -18,6 +19,8 @@
 #define AIU_958_MISC_MODE_32BITS	BIT(7)
 #define AIU_958_MISC_U_FROM_STREAM	BIT(12)
 #define AIU_958_MISC_FORCE_LR		BIT(13)
+#define AIU_958_VALID_CTRL_V		BIT(0)
+#define AIU_958_VALID_CTRL_EN		BIT(1)
 #define AIU_958_CTRL_HOLD_EN		BIT(0)
 #define AIU_CLK_CTRL_958_DIV_EN		BIT(1)
 #define AIU_CLK_CTRL_958_DIV		GENMASK(5, 4)
@@ -68,14 +71,15 @@ aiu_encoder_spdif_trigger(struct snd_pcm_substream *substream, int cmd,
 }
 
 static int aiu_encoder_spdif_setup_cs_word(struct snd_soc_component *component,
-					   struct snd_pcm_hw_params *params)
+					   struct snd_pcm_runtime *runtime)
 {
+	struct aiu *aiu = snd_soc_component_get_drvdata(component);
 	u8 cs[AIU_CS_WORD_LEN];
 	unsigned int val;
 	int ret;
 
-	ret = snd_pcm_create_iec958_consumer_hw_params(params, cs,
-						       AIU_CS_WORD_LEN);
+	memcpy(cs, aiu->iec_status, AIU_CS_WORD_LEN);
+	ret = snd_pcm_fill_iec958_consumer(runtime, cs, AIU_CS_WORD_LEN);
 	if (ret < 0)
 		return ret;
 
@@ -89,6 +93,15 @@ static int aiu_encoder_spdif_setup_cs_word(struct snd_soc_component *component,
 	snd_soc_component_write(component, AIU_958_CHSTAT_L1, val);
 	snd_soc_component_write(component, AIU_958_CHSTAT_R1, val);
 
+	/*
+	 * The validity flag says the samples of a frame are not suitable for
+	 * conversion to analogue, which is the case for a compressed stream.
+	 * The encoder only drives it while the control is enabled.
+	 */
+	val = cs[0] & IEC958_AES0_NONAUDIO ?
+	      AIU_958_VALID_CTRL_EN | AIU_958_VALID_CTRL_V : 0;
+	snd_soc_component_write(component, AIU_958_VALID_CTRL, val);
+
 	return 0;
 }
 
@@ -126,13 +139,6 @@ static int aiu_encoder_spdif_hw_params(struct snd_pcm_substream *substream,
 				      AIU_958_MISC_U_FROM_STREAM,
 				      val);
 
-	/* Set the stream channel status word */
-	ret = aiu_encoder_spdif_setup_cs_word(component, params);
-	if (ret) {
-		dev_err(dai->dev, "failed to set channel status word\n");
-		return ret;
-	}
-
 	snd_soc_component_update_bits(component, AIU_CLK_CTRL,
 				      AIU_CLK_CTRL_958_DIV |
 				      AIU_CLK_CTRL_958_DIV_MORE,
@@ -152,6 +158,21 @@ static int aiu_encoder_spdif_hw_params(struct snd_pcm_substream *substream,
 	return 0;
 }
 
+static int aiu_encoder_spdif_prepare(struct snd_pcm_substream *substream,
+				     struct snd_soc_dai *dai)
+{
+	struct snd_soc_component *component = dai->component;
+	int ret;
+
+	ret = aiu_encoder_spdif_setup_cs_word(component, substream->runtime);
+	if (ret) {
+		dev_err(dai->dev, "failed to set channel status word\n");
+		return ret;
+	}
+
+	return 0;
+}
+
 static int aiu_encoder_spdif_hw_free(struct snd_pcm_substream *substream,
 				     struct snd_soc_dai *dai)
 {
@@ -202,6 +223,7 @@ static void aiu_encoder_spdif_shutdown(struct snd_pcm_substream *substream,
 
 const struct snd_soc_dai_ops aiu_encoder_spdif_dai_ops = {
 	.trigger	= aiu_encoder_spdif_trigger,
+	.prepare	= aiu_encoder_spdif_prepare,
 	.hw_params	= aiu_encoder_spdif_hw_params,
 	.hw_free	= aiu_encoder_spdif_hw_free,
 	.startup	= aiu_encoder_spdif_startup,
diff --git a/sound/soc/meson/aiu.c b/sound/soc/meson/aiu.c
index 14d0e20a4bd6..d461b68c3dc0 100644
--- a/sound/soc/meson/aiu.c
+++ b/sound/soc/meson/aiu.c
@@ -9,6 +9,8 @@
 #include <linux/of_platform.h>
 #include <linux/regmap.h>
 #include <linux/reset.h>
+#include <sound/pcm.h>
+#include <sound/pcm_iec958.h>
 #include <sound/soc.h>
 #include <sound/soc-dai.h>
 
@@ -29,6 +31,69 @@ static SOC_ENUM_SINGLE_DECL(aiu_spdif_encode_sel_enum, AIU_I2S_MISC,
 static const struct snd_kcontrol_new aiu_spdif_encode_mux =
 	SOC_DAPM_ENUM("SPDIF Buffer Src", aiu_spdif_encode_sel_enum);
 
+static int aiu_iec958_info(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_IEC958;
+	uinfo->count = 1;
+
+	return 0;
+}
+
+static int aiu_iec958_mask_get(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *ucontrol)
+{
+	memset(ucontrol->value.iec958.status, 0xff,
+	       sizeof(ucontrol->value.iec958.status));
+
+	return 0;
+}
+
+static int aiu_iec958_get(struct snd_kcontrol *kcontrol,
+			  struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct aiu *aiu = snd_soc_component_get_drvdata(component);
+
+	memcpy(ucontrol->value.iec958.status, aiu->iec_status,
+	       sizeof(aiu->iec_status));
+
+	return 0;
+}
+
+static int aiu_iec958_put(struct snd_kcontrol *kcontrol,
+			  struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct aiu *aiu = snd_soc_component_get_drvdata(component);
+
+	if (!memcmp(aiu->iec_status, ucontrol->value.iec958.status,
+		    sizeof(aiu->iec_status)))
+		return 0;
+
+	memcpy(aiu->iec_status, ucontrol->value.iec958.status,
+	       sizeof(aiu->iec_status));
+
+	return 1;
+}
+
+static const struct snd_kcontrol_new aiu_cpu_controls[] = {
+	{
+		.access	= SNDRV_CTL_ELEM_ACCESS_READ,
+		.iface	= SNDRV_CTL_ELEM_IFACE_PCM,
+		.name	= SNDRV_CTL_NAME_IEC958("", PLAYBACK, MASK),
+		.info	= aiu_iec958_info,
+		.get	= aiu_iec958_mask_get,
+	},
+	{
+		.iface	= SNDRV_CTL_ELEM_IFACE_PCM,
+		.name	= SNDRV_CTL_NAME_IEC958("", PLAYBACK, DEFAULT),
+		.info	= aiu_iec958_info,
+		.get	= aiu_iec958_get,
+		.put	= aiu_iec958_put,
+	},
+};
+
 #define AIU_WIDGET_SPDIF_SRC_SEL	0
 #define AIU_WIDGET_I2S_FORMATTER	1
 
@@ -104,6 +169,8 @@ static void aiu_cpu_component_remove(struct snd_soc_component *component)
 
 static const struct snd_soc_component_driver aiu_cpu_component = {
 	.name			= "AIU CPU",
+	.controls		= aiu_cpu_controls,
+	.num_controls		= ARRAY_SIZE(aiu_cpu_controls),
 	.dapm_widgets		= aiu_cpu_dapm_widgets,
 	.num_dapm_widgets	= ARRAY_SIZE(aiu_cpu_dapm_widgets),
 	.dapm_routes		= aiu_cpu_dapm_routes,
@@ -277,6 +344,11 @@ static int aiu_probe(struct platform_device *pdev)
 
 	platform_set_drvdata(pdev, aiu);
 
+	ret = snd_pcm_create_iec958_consumer_default(aiu->iec_status,
+						     sizeof(aiu->iec_status));
+	if (ret < 0)
+		return ret;
+
 	ret = device_reset(dev);
 	if (ret)
 		return dev_err_probe(dev, ret, "Failed to reset device\n");
diff --git a/sound/soc/meson/aiu.h b/sound/soc/meson/aiu.h
index 7d0b98c1f351..ddadc29bf2f8 100644
--- a/sound/soc/meson/aiu.h
+++ b/sound/soc/meson/aiu.h
@@ -7,6 +7,8 @@
 #ifndef _MESON_AIU_H
 #define _MESON_AIU_H
 
+#include <sound/asoundef.h>
+
 #include "gx-formatter.h"
 
 struct clk;
@@ -40,6 +42,7 @@ struct aiu {
 	struct aiu_interface i2s;
 	struct aiu_interface spdif;
 	const struct aiu_platform_data *platform;
+	u8 iec_status[AES_IEC958_STATUS_SIZE];
 };
 
 #define AIU_FORMATS (SNDRV_PCM_FMTBIT_S16_LE |	\
@@ -81,6 +84,7 @@ extern const struct gx_formatter_ops aiu_formatter_i2s_ops;
 #define AIU_ACODEC_CTRL			0x0b0
 #define AIU_958_CHSTAT_R0		0x0c0
 #define AIU_958_CHSTAT_R1		0x0c4
+#define AIU_958_VALID_CTRL		0x0c8
 #define AIU_MEM_I2S_START		0x180
 #define AIU_MEM_I2S_MASKS		0x18c
 #define AIU_MEM_I2S_CONTROL		0x190
-- 
2.43.0

