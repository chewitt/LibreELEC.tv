From 8663fc1d4b569d3955d42799b2752ddc58c413a1 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Fri, 18 Sep 2026 15:07:28 +0000
Subject: [PATCH 166/177] ASoC: meson: aiu: support eight channels on the
 S/PDIF encoder

The encoder is declared as carrying two channels, which is all an
optical output can take, but it also feeds the HDMI transmitter on these
SoCs and an HBR stream is eight channels of IEC61937 at 192kHz.

The frame it lays on the wire is two samples wide whatever the stream
is, so a stream of more than two channels is carried by running the
frame faster rather than by widening it: eight channels at 192kHz is a
stereo frame at 768kHz, which is the IEC60958 frame sequence an HBR
stream is carried in.  That is four times the bit rate of a stereo
frame, which is the master clock with the internal divider bypassed,
and it is what the vendor driver programs for TrueHD and DTS-HD MA.

Scale the master clock with the channel count, take the divider out of
the way where it cannot give the rate, and let the FIFO and the encoder
advertise eight channels.

The divisor field holds one less than the divisor it selects, so write
it as such rather than as __ffs().  The two agree on the values used
here and disagree at four, where the field selects three.

Assisted-by: Claude:claude-opus-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 sound/soc/meson/aiu-encoder-spdif.c | 17 +++++++++++++----
 sound/soc/meson/aiu-fifo-spdif.c    |  2 +-
 sound/soc/meson/aiu.c               |  4 ++--
 3 files changed, 16 insertions(+), 7 deletions(-)

diff --git a/sound/soc/meson/aiu-encoder-spdif.c b/sound/soc/meson/aiu-encoder-spdif.c
index 70f5684ef4f1..d1bc7209cd6e 100644
--- a/sound/soc/meson/aiu-encoder-spdif.c
+++ b/sound/soc/meson/aiu-encoder-spdif.c
@@ -111,7 +111,7 @@ static int aiu_encoder_spdif_hw_params(struct snd_pcm_substream *substream,
 {
 	struct snd_soc_component *component = dai->component;
 	struct aiu *aiu = snd_soc_component_get_drvdata(component);
-	unsigned int val = 0, mrate;
+	unsigned int val = 0, mrate, div;
 	int ret;
 
 	/* Disable the clock while changing the settings */
@@ -139,14 +139,23 @@ static int aiu_encoder_spdif_hw_params(struct snd_pcm_substream *substream,
 				      AIU_958_MISC_U_FROM_STREAM,
 				      val);
 
+	/*
+	 * The encoder lays a frame of two samples on the wire whatever the
+	 * stream is, so a stream of more than two channels is carried by
+	 * running the frame faster rather than by widening it.  Eight
+	 * channels need four times the bit rate of a stereo frame, which is
+	 * the master clock undivided.
+	 */
+	div = params_channels(params) > 2 ? 1 : AIU_958_INTERNAL_DIV;
+
 	snd_soc_component_update_bits(component, AIU_CLK_CTRL,
 				      AIU_CLK_CTRL_958_DIV |
 				      AIU_CLK_CTRL_958_DIV_MORE,
 				      FIELD_PREP(AIU_CLK_CTRL_958_DIV,
-						 __ffs(AIU_958_INTERNAL_DIV)));
+						 div - 1));
 
-	/* 2 * 32bits per subframe * 2 channels = 128 */
-	mrate = params_rate(params) * 128 * AIU_958_INTERNAL_DIV;
+	/* 2 clocks per bit * 32bits per subframe * one subframe per channel */
+	mrate = params_rate(params) * 64 * params_channels(params) * div;
 	ret = clk_set_rate(aiu->spdif.clks[MCLK].clk, mrate);
 	if (ret) {
 		dev_err(dai->dev, "failed to set mclk rate\n");
diff --git a/sound/soc/meson/aiu-fifo-spdif.c b/sound/soc/meson/aiu-fifo-spdif.c
index 900ffd98ced9..571e2565806b 100644
--- a/sound/soc/meson/aiu-fifo-spdif.c
+++ b/sound/soc/meson/aiu-fifo-spdif.c
@@ -38,7 +38,7 @@ static const struct snd_pcm_hardware fifo_spdif_pcm = {
 	.rate_min = 5512,
 	.rate_max = 192000,
 	.channels_min = 2,
-	.channels_max = 2,
+	.channels_max = 8,
 	.period_bytes_min = AIU_FIFO_SPDIF_BURST,
 	.period_bytes_max = ALIGN_DOWN(USHRT_MAX, AIU_FIFO_SPDIF_BURST),
 	.periods_min = 2,
diff --git a/sound/soc/meson/aiu.c b/sound/soc/meson/aiu.c
index d461b68c3dc0..79d621bac4c4 100644
--- a/sound/soc/meson/aiu.c
+++ b/sound/soc/meson/aiu.c
@@ -203,7 +203,7 @@ static struct snd_soc_dai_driver aiu_cpu_dai_drv[] = {
 		.playback = {
 			.stream_name	= "SPDIF FIFO Playback",
 			.channels_min	= 2,
-			.channels_max	= 2,
+			.channels_max	= 8,
 			.rates		= SNDRV_PCM_RATE_CONTINUOUS,
 			.rate_min	= 5512,
 			.rate_max	= 192000,
@@ -235,7 +235,7 @@ static struct snd_soc_dai_driver aiu_cpu_dai_drv[] = {
 		.playback = {
 			.stream_name = "SPDIF Encoder Playback",
 			.channels_min = 2,
-			.channels_max = 2,
+			.channels_max = 8,
 			.rates = (SNDRV_PCM_RATE_32000  |
 				  SNDRV_PCM_RATE_44100  |
 				  SNDRV_PCM_RATE_48000  |
-- 
