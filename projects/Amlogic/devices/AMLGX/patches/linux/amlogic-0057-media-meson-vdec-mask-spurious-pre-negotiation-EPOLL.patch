From ff3c5773a377d432e65ed067c9cb728b138ae756 Mon Sep 17 00:00:00 2001
From: Gus Bourg <gus@bourg.net>
Date: Wed, 2 Sep 2026 17:30:00 -0700
Subject: [PATCH 057/145] media: meson: vdec: mask spurious pre-negotiation
 EPOLLERR from poll

Until the CAPTURE queue has streamed for the first time, an
empty-queues state is the normal 'waiting for the initial
source-change event' phase of a stateful decoder: the OUTPUT buffers
holding the header have already been consumed by the esparser while
the firmware is still parsing.  The m2m poll helper reports that
transient state as EPOLLERR, which userspace (GStreamer) treats as
fatal - and whether the window is hit is a race against the parser,
so sessions fail at random (observed 3/8 to 6/10 success rates,
revents=POLLERR with no POLLPRI in strace).  Mask the spurious error
until capture streams.

With this, 10/10 VP9, 8/8 H.264 and 5/5 MPEG2 sessions complete on a
GStreamer 1.26 stateful-decode flow that previously failed randomly.
---
 drivers/staging/media/meson/vdec/vdec.c | 26 +++++++++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/drivers/staging/media/meson/vdec/vdec.c b/drivers/staging/media/meson/vdec/vdec.c
index a1ef73bc9e20..d169100239c0 100644
--- a/drivers/staging/media/meson/vdec/vdec.c
+++ b/drivers/staging/media/meson/vdec/vdec.c
@@ -953,12 +953,35 @@ static int vdec_close(struct file *file)
 	return 0;
 }
 
+static __poll_t vdec_fop_poll(struct file *file, poll_table *wait)
+{
+	struct amvdec_session *sess =
+		container_of(file->private_data, struct amvdec_session, fh);
+	__poll_t ret = v4l2_m2m_fop_poll(file, wait);
+
+	/*
+	 * Until the CAPTURE queue has streamed for the first time, an
+	 * empty-queues state is the normal "waiting for the initial
+	 * source-change event" phase of a stateful decoder: the OUTPUT
+	 * buffers holding the header have been consumed by the esparser
+	 * while the firmware is still parsing.  The m2m poll helper
+	 * reports that transient state as EPOLLERR, which userspace
+	 * (GStreamer) treats as fatal - whether the window is hit is a
+	 * race against the parser, failing sessions at random.  Mask the
+	 * spurious error until capture streams.
+	 */
+	if (!sess->streamon_cap && (ret & EPOLLERR))
+		ret &= ~EPOLLERR;
+
+	return ret;
+}
+
 static const struct v4l2_file_operations vdec_fops = {
 	.owner = THIS_MODULE,
 	.open = vdec_open,
 	.release = vdec_close,
 	.unlocked_ioctl = video_ioctl2,
-	.poll = v4l2_m2m_fop_poll,
+	.poll = vdec_fop_poll,
 	.mmap = v4l2_m2m_fop_mmap,
 };
 
@@ -966,7 +989,6 @@ static irqreturn_t vdec_isr(int irq, void *data)
 {
 	struct amvdec_core *core = data;
 	struct amvdec_session *sess = core->cur_sess;
-
 	sess->last_irq_jiffies = get_jiffies_64();
 
 	return sess->fmt_out->codec_ops->isr(sess);
-- 
