From cb62cc86b6205dd8c80f420d3f20d80a8ba1f68c Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Sat, 12 Sep 2026 09:56:52 +0000
Subject: [PATCH 135/145] media: meson: vdec: hevc: discard RASL pictures after
 an opening CRA

The RASL pictures that follow a CRA or BLA in decode order predict from
pictures that precede it.  When that IRAP is where the stream was
entered - after a seek, or a session starting mid-GOP - those pictures
were never decoded, so H.265 8.1.3 says the RASL pictures are not
decoded either: NoRaslOutputFlag is 1 for such an IRAP and its RASL
pictures are dropped.

This decoder decoded them anyway, and
"media: meson: vdec: hevc: substitute missing reference frames" made
that worse rather than better: instead of programming a null reference
it hands the firmware the nearest completed frame, so the hardware is
asked to reconstruct a picture from references that have nothing to do
with it.  On a seek into One Hour Photo (CRA random-access points) the
firmware stalls on the first such picture and never recovers - 31
in-place recoveries, then "No dst buffer available" and an aborted
session.  Substitution keeps its place for references that go missing
mid-GOP, which is what it was written for.

Track the run of leading pictures from the IRAP that ended the resync
and skip them through the same nal-skip path the pre-IRAP slices use.
The run ends at the first trailing picture, and a stream whose
random-access points are IDR never enters it.

Fixes: 11311d7d8739 ("media: meson: vdec: hevc: substitute missing reference frames")
Assisted-by: Claude:claude-opus-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 drivers/staging/media/meson/vdec/codec_hevc.c | 30 +++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/drivers/staging/media/meson/vdec/codec_hevc.c b/drivers/staging/media/meson/vdec/codec_hevc.c
index 8e8f72354170..ed62ad8e3a0c 100644
--- a/drivers/staging/media/meson/vdec/codec_hevc.c
+++ b/drivers/staging/media/meson/vdec/codec_hevc.c
@@ -222,6 +222,8 @@ union rpm_param {
 };
 
 enum nal_unit_type {
+	NAL_UNIT_CODED_SLICE_RASL_N	= 8,
+	NAL_UNIT_CODED_SLICE_RASL_R	= 9,
 	NAL_UNIT_CODED_SLICE_BLA	= 16,
 	NAL_UNIT_CODED_SLICE_BLANT	= 17,
 	NAL_UNIT_CODED_SLICE_BLA_N_LP	= 18,
@@ -265,6 +267,8 @@ struct codec_hevc {
 	 * has no valid references at all).
 	 */
 	u32 seen_irap;
+	/* Discarding the leading pictures of the CRA that opened the stream */
+	bool drop_rasl;
 
 	/*
 	 * In-session stall recovery (vendor decode-timeout protocol).
@@ -359,6 +363,8 @@ static void codec_hevc_set_resync(struct amvdec_session *sess, bool on)
 
 	hevc->seen_irap = !on;
 	sess->resyncing = on;
+	if (on)
+		hevc->drop_rasl = false;
 }
 
 static u32 codec_hevc_num_pending_bufs(struct amvdec_session *sess)
@@ -2024,6 +2030,9 @@ static int codec_hevc_process_segment(struct amvdec_session *sess)
 		if (nal_type >= NAL_UNIT_CODED_SLICE_BLA &&
 		    nal_type <= NAL_UNIT_CODED_SLICE_CRA) {
 			codec_hevc_set_resync(sess, false);
+			hevc->drop_rasl =
+				nal_type != NAL_UNIT_CODED_SLICE_IDR &&
+				nal_type != NAL_UNIT_CODED_SLICE_IDR_N_LP;
 		} else {
 			dev_dbg(core->dev,
 				"skipping pre-IRAP slice (nal %u)\n",
@@ -2032,6 +2041,27 @@ static int codec_hevc_process_segment(struct amvdec_session *sess)
 		}
 	}
 
+	/*
+	 * The RASL pictures that follow a CRA or BLA in decode order
+	 * predict from pictures that precede it, so when that IRAP is where
+	 * the stream was entered - a seek, or a session starting mid-GOP -
+	 * none of those references exist.  H.265 8.1.3 says not to decode
+	 * them at all.  Substituting whatever reference is to hand instead
+	 * feeds the firmware a picture it cannot reconstruct, and it stalls
+	 * on the attempt.  They end at the first trailing picture.
+	 */
+	if (hevc->drop_rasl) {
+		if (nal_type == NAL_UNIT_CODED_SLICE_RASL_N ||
+		    nal_type == NAL_UNIT_CODED_SLICE_RASL_R) {
+			dev_dbg(core->dev, "skipping RASL slice (nal %u)\n",
+				nal_type);
+			return codec_hevc_skip_slice(sess);
+		}
+
+		if (nal_type < NAL_UNIT_CODED_SLICE_BLA)
+			hevc->drop_rasl = false;
+	}
+
 	/* First slice: new frame */
 	if (slice_segment_address == 0) {
 		codec_hevc_update_referenced(hevc);
-- 
2.43.0

