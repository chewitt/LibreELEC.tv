From 16b65c73b55286000082d0dbcc0889fe03301f6b Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Sat, 12 Sep 2026 07:03:21 +0000
Subject: [PATCH 131/145] media: meson: vdec: hevc: write the whole gxbb canvas
 table

"do not demand every CAPTURE buffer be queued" fixed the reference
canvas table for gxl and later, where the ANC2AXI table auto-increments
from slot 0, but left the gxbb variant walking the queued list.  gxbb is
the only user of that variant, and the two hazards the commit describes
are still live there.

Entries on gxbb carry their own slot number rather than arriving in
order, so queue order does no harm - but a buffer that is not queued at
setup time gets no entry at all.  Since min_queued_buffers dropped to
the interface minimum for codecs with a resume op, that is most of the
CAPTURE queue: HEVC resumes with four buffers queued out of twenty, and
the other sixteen slots keep the zeroes left by the CONF_ADDR reset.
The reference lists address the table by vb2_buf.index regardless, so
the MC engine predicts from physical page zero for every reference to a
buffer that happened to be off the queue.  Intra frames still decode, so
the picture keeps some structure - outlines, titles - while everything
predicted from those references is blocks of green and magenta, and a
stream whose current frame lands in an unwritten slot simply stops
moving.

The loop meant to cover the unwritten tail cannot do it: the value it
repeats still carries the last buffer's slot number in bits 15:8, so all
of its writes land on that one slot.

Write the table over the full index space instead, from the buffers
collected by index, and give a slot with no buffer behind it the address
of a real one - the same treatment the gxl path got, and what the vendor
init_pic_list_hw() does over MAX_REF_PIC_NUM.

Fixes: 4d5aa6490a97 ("media: meson: vdec: do not demand every CAPTURE buffer be queued")
Assisted-by: Claude:claude-opus-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 .../media/meson/vdec/codec_hevc_common.c      | 85 ++++++++++++-------
 1 file changed, 56 insertions(+), 29 deletions(-)

diff --git a/drivers/staging/media/meson/vdec/codec_hevc_common.c b/drivers/staging/media/meson/vdec/codec_hevc_common.c
index 61e23c95ef10..d55b0ec65d8f 100644
--- a/drivers/staging/media/meson/vdec/codec_hevc_common.c
+++ b/drivers/staging/media/meson/vdec/codec_hevc_common.c
@@ -352,50 +352,77 @@ static void codec_hevc_setup_buffers_gxbb(struct amvdec_session *sess,
 					  int is_10bit)
 {
 	struct amvdec_core *core = sess->core;
-	struct v4l2_m2m_buffer *buf;
-	u32 buf_num = v4l2_m2m_num_dst_bufs_ready(sess->m2m_ctx);
-	dma_addr_t buf_y_paddr = 0;
-	dma_addr_t buf_uv_paddr = 0;
-	u32 idx = 0;
-	u32 val;
+	struct vb2_buffer *bufs[MAX_REF_PIC_NUM];
+	const bool fbc = codec_hevc_use_fbc(sess->pixfmt_cap, is_10bit);
+	dma_addr_t fill_y = 0, fill_uv = 0;
+	unsigned int idx, n;
 	int i;
 
-	amvdec_write_dos(core, HEVCD_MPP_ANC2AXI_TBL_CONF_ADDR, 0);
+	/*
+	 * Unlike the auto-incrementing table on gxl and later, every entry
+	 * here carries its own slot number, so the table can be - and must
+	 * be - written for the whole index space: the reference lists
+	 * address it by vb2_buf.index (index * 2 and index * 2 + 1 for the
+	 * two-plane formats), whether or not that buffer happens to be
+	 * queued right now.  A slot left unwritten reads as address zero
+	 * and the MC engine predicts from physical page 0.
+	 *
+	 * A slot with no buffer behind it is never referenced by a correct
+	 * decode; point it at a real buffer anyway so that a corrupt
+	 * reference reads valid memory.
+	 */
+	n = codec_hevc_capture_buffers(sess, bufs);
+	if (!n)
+		return;
 
-	v4l2_m2m_for_each_dst_buf(sess->m2m_ctx, buf) {
-		struct vb2_buffer *vb = &buf->vb.vb2_buf;
+	for (idx = 0; idx < n; idx++) {
+		if (!bufs[idx])
+			continue;
 
-		idx = vb->index;
+		fill_y = fbc ? comm->fbc_buffer_paddr[idx] :
+			       vb2_dma_contig_plane_dma_addr(bufs[idx], 0);
+		if (!fill_y)
+			continue;
 
-		if (codec_hevc_use_fbc(sess->pixfmt_cap, is_10bit))
+		if (!fbc)
+			fill_uv = vb2_dma_contig_plane_dma_addr(bufs[idx], 1);
+		break;
+	}
+
+	if (!fill_y)
+		return;
+
+	amvdec_write_dos(core, HEVCD_MPP_ANC2AXI_TBL_CONF_ADDR, 0);
+
+	for (idx = 0; idx < MAX_REF_PIC_NUM; idx++) {
+		struct vb2_buffer *vb = idx < n ? bufs[idx] : NULL;
+		dma_addr_t buf_y_paddr = 0;
+		dma_addr_t buf_uv_paddr = 0;
+
+		if (vb && fbc) {
 			buf_y_paddr = comm->fbc_buffer_paddr[idx];
-		else
+		} else if (vb) {
 			buf_y_paddr = vb2_dma_contig_plane_dma_addr(vb, 0);
+			buf_uv_paddr = vb2_dma_contig_plane_dma_addr(vb, 1);
+		}
+
+		if (!buf_y_paddr) {
+			buf_y_paddr = fill_y;
+			buf_uv_paddr = fill_uv;
+		}
 
-		if (codec_hevc_use_fbc(sess->pixfmt_cap, is_10bit)) {
-			val = buf_y_paddr | (idx << 8) | 1;
+		if (fbc) {
 			amvdec_write_dos(core, HEVCD_MPP_ANC2AXI_TBL_CMD_ADDR,
-					 val);
+					 buf_y_paddr | (idx << 8) | 1);
 		} else {
-			buf_uv_paddr = vb2_dma_contig_plane_dma_addr(vb, 1);
-			val = buf_y_paddr | ((idx * 2) << 8) | 1;
 			amvdec_write_dos(core, HEVCD_MPP_ANC2AXI_TBL_CMD_ADDR,
-					 val);
-			val = buf_uv_paddr | ((idx * 2 + 1) << 8) | 1;
+					 buf_y_paddr | ((idx * 2) << 8) | 1);
 			amvdec_write_dos(core, HEVCD_MPP_ANC2AXI_TBL_CMD_ADDR,
-					 val);
+					 buf_uv_paddr | ((idx * 2 + 1) << 8) |
+					 1);
 		}
 	}
 
-	if (codec_hevc_use_fbc(sess->pixfmt_cap, is_10bit))
-		val = buf_y_paddr | (idx << 8) | 1;
-	else
-		val = buf_y_paddr | ((idx * 2) << 8) | 1;
-
-	/* Fill the remaining unused slots with the last buffer's Y addr */
-	for (i = buf_num; i < MAX_REF_PIC_NUM; ++i)
-		amvdec_write_dos(core, HEVCD_MPP_ANC2AXI_TBL_CMD_ADDR, val);
-
 	amvdec_write_dos(core, HEVCD_MPP_ANC2AXI_TBL_CONF_ADDR, 1);
 	amvdec_write_dos(core, HEVCD_MPP_ANC_CANVAS_ACCCONFIG_ADDR, 1);
 	for (i = 0; i < 32; ++i)
-- 
2.43.0

