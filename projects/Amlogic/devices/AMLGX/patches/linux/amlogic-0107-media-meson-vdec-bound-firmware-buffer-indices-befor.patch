From 4533b69a1556c917941bba72034067a732378c4a Mon Sep 17 00:00:00 2001
From: gus bourg <gus@bourg.net>
Date: Thu, 10 Sep 2026 06:29:20 -0700
Subject: [PATCH 107/145] media: meson: vdec: bound firmware buffer indices
 before lookup

Reject an out-of-range firmware completion index before reading the
firmware-to-vb2 map. Preserve the existing error-return behavior without
accessing past the 32-entry array.

This is independent hardening, not the fix for the in-range H.264 seek
failures.

Signed-off-by: gus bourg <gus@bourg.net>
---
 drivers/staging/media/meson/vdec/vdec_helpers.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/drivers/staging/media/meson/vdec/vdec_helpers.c b/drivers/staging/media/meson/vdec/vdec_helpers.c
index af48066cd21e..da350f94b9d4 100644
--- a/drivers/staging/media/meson/vdec/vdec_helpers.c
+++ b/drivers/staging/media/meson/vdec/vdec_helpers.c
@@ -512,6 +512,11 @@ void amvdec_dst_buf_done_idx(struct amvdec_session *sess,
 	struct vb2_v4l2_buffer *vbuf;
 	struct device *dev = sess->core->dev_dec;
 
+	if (buf_idx >= ARRAY_SIZE(sess->fw_idx_to_vb2_idx)) {
+		dev_err(dev, "Invalid firmware buffer index %u\n", buf_idx);
+		return;
+	}
+
 	vbuf = v4l2_m2m_dst_buf_remove_by_idx(sess->m2m_ctx,
 					      sess->fw_idx_to_vb2_idx[buf_idx]);
 
-- 
