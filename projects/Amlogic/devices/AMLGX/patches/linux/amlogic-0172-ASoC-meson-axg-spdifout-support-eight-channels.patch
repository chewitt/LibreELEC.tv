From dff66351e1aa0b88965187a6f3b22652584ada3c Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Thu, 17 Sep 2026 05:53:11 +0000
Subject: [PATCH 172/177] ASoC: meson: axg-spdifout: support eight channels

The encoder is declared as carrying two channels, which is all an optical
output needs, but it also feeds the HDMI transmitter on these SoCs and an
HBR stream is eight channels of IEC61937 at 192kHz.

The frame it lays on the wire is two samples wide whatever the stream is.
The channel mask says how many samples the encoder takes from the FIFO
for each frame and the master clock says how often, so a stream of more
than two channels is carried by running the frame faster rather than by
widening it: eight channels at 192kHz is a stereo frame at 768kHz, which
is the IEC60958 frame sequence an HBR stream is carried in.

Scale the master clock with the channel count and let the DAI advertise
eight.  A frame carries one 32 bit subframe per channel, so eight
channels need four times the bit rate of a stereo frame; the vendor
driver arrives at the same multiplier from the codec type instead.

Assisted-by: Claude:claude-opus-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 sound/soc/meson/axg-spdifout.c | 25 ++++++++++++++-----------
 1 file changed, 14 insertions(+), 11 deletions(-)

diff --git a/sound/soc/meson/axg-spdifout.c b/sound/soc/meson/axg-spdifout.c
index 1093b020405e..862efc614955 100644
--- a/sound/soc/meson/axg-spdifout.c
+++ b/sound/soc/meson/axg-spdifout.c
@@ -57,6 +57,8 @@
 #define SPDIFOUT_CHSTSB			0x48
 #define SPDIFOUT_MUTE_VAL		0x4c
 
+#define SPDIFOUT_CH_MAX			8
+
 struct axg_spdifout {
 	struct regmap *map;
 	struct clk *mclk;
@@ -133,19 +135,19 @@ static int axg_spdifout_sample_fmt(struct snd_pcm_hw_params *params,
 	unsigned int val;
 
 	/* Set the samples spdifout will pull from the FIFO */
-	switch (params_channels(params)) {
-	case 1:
-		val = SPDIFOUT_CTRL0_MASK(0x1);
-		break;
-	case 2:
-		val = SPDIFOUT_CTRL0_MASK(0x3);
-		break;
-	default:
+	if (params_channels(params) > SPDIFOUT_CH_MAX) {
 		dev_err(dai->dev, "too many channels for spdif dai: %u\n",
 			params_channels(params));
 		return -EINVAL;
 	}
 
+	/*
+	 * The encoder pulls one frame of two samples at a time, so a stream
+	 * of more than two channels is carried by running the frame faster
+	 * rather than by widening it.
+	 */
+	val = SPDIFOUT_CTRL0_MASK(params_channels(params) > 1 ? 0x3 : 0x1);
+
 	regmap_update_bits(priv->map, SPDIFOUT_CTRL0,
 			   SPDIFOUT_CTRL0_MASK_MASK, val);
 
@@ -225,11 +227,12 @@ static int axg_spdifout_hw_params(struct snd_pcm_substream *substream,
 				  struct snd_soc_dai *dai)
 {
 	struct axg_spdifout *priv = snd_soc_dai_get_drvdata(dai);
+	unsigned int channels = max(params_channels(params), 2u);
 	unsigned int rate = params_rate(params);
 	int ret;
 
-	/* 2 * 32bits per subframe * 2 channels = 128 */
-	ret = clk_set_rate(priv->mclk, rate * 128);
+	/* 2 clocks per bit * 32bits per subframe * one subframe per channel */
+	ret = clk_set_rate(priv->mclk, rate * 64 * channels);
 	if (ret) {
 		dev_err(dai->dev, "failed to set spdif clock\n");
 		return ret;
@@ -315,7 +318,7 @@ static struct snd_soc_dai_driver axg_spdifout_dai_drv[] = {
 		.playback = {
 			.stream_name	= "Playback",
 			.channels_min	= 1,
-			.channels_max	= 2,
+			.channels_max	= SPDIFOUT_CH_MAX,
 			.rates		= (SNDRV_PCM_RATE_32000  |
 					   SNDRV_PCM_RATE_44100  |
 					   SNDRV_PCM_RATE_48000  |
-- 
