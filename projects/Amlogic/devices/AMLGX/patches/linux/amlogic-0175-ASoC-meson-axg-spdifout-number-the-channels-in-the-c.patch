From 3ef3b0094e1b94f8c4e0627f17c394e891e01074 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Fri, 18 Sep 2026 06:17:52 +0000
Subject: [PATCH 175/177] ASoC: meson: axg-spdifout: number the channels in the
 channel status

The channel status written to the two blocks of a frame is the same, so
both name channel number zero, where the vendor driver names the first
channel in one and the second in the other.

A receiver reassembling an IEC61937 burst from alternating subframes has
the channel number to keep its place with, and a stream that never names
one leaves it nothing to resynchronise against.

Number the channel the block carries.

Assisted-by: Claude:claude-opus-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 sound/soc/meson/axg-spdifout.c | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/sound/soc/meson/axg-spdifout.c b/sound/soc/meson/axg-spdifout.c
index 862efc614955..8c23d47d91f0 100644
--- a/sound/soc/meson/axg-spdifout.c
+++ b/sound/soc/meson/axg-spdifout.c
@@ -203,8 +203,16 @@ static int axg_spdifout_set_chsts(struct snd_pcm_runtime *runtime,
 	}
 	val = cs[0] | cs[1] << 8 | cs[2] << 16 | cs[3] << 24;
 
+	/*
+	 * The channel status names the channel a subframe carries, the first
+	 * of the frame and then the second, so that a receiver reassembling
+	 * a stream knows where in the frame it is.
+	 */
+	val &= ~(IEC958_AES2_CON_CHANNEL << 16);
+
 	/* Setup channel status A bits [31 - 0]*/
-	regmap_write(priv->map, SPDIFOUT_CHSTS0, val);
+	regmap_write(priv->map, SPDIFOUT_CHSTS0,
+		     val | (1 << 4) << 16);
 
 	/* Clear channel status A bits [191 - 32] */
 	for (offset = SPDIFOUT_CHSTS1; offset <= SPDIFOUT_CHSTS5;
@@ -212,7 +220,8 @@ static int axg_spdifout_set_chsts(struct snd_pcm_runtime *runtime,
 		regmap_write(priv->map, offset, 0);
 
 	/* Setup channel status B bits [31 - 0]*/
-	regmap_write(priv->map, SPDIFOUT_CHSTS6, val);
+	regmap_write(priv->map, SPDIFOUT_CHSTS6,
+		     val | (2 << 4) << 16);
 
 	/* Clear channel status B bits [191 - 32] */
 	for (offset = SPDIFOUT_CHSTS7; offset <= SPDIFOUT_CHSTSB;
-- 
