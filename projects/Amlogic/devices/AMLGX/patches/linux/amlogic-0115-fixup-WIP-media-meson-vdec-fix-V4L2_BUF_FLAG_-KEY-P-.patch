From bc2c1081f413982f82d4918186425856a1451549 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Thu, 10 Sep 2026 15:52:30 +0000
Subject: [PATCH 115/145] fixup! WIP: media: meson: vdec: fix
 V4L2_BUF_FLAG_{KEY|P|B}FRAME

The type argument added to amvdec_dst_buf_done_idx() was wired up for
h264, hevc, mpeg12 and vp9, but the mpeg4 and vc1 callers earlier in
the series were missed, breaking the build. Neither codec reports a
frame type to the driver, so pass 0 as mpeg12 does.

Assisted-by: Claude:claude-opus-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 drivers/staging/media/meson/vdec/codec_mpeg4.c | 2 +-
 drivers/staging/media/meson/vdec/codec_vc1.c   | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/staging/media/meson/vdec/codec_mpeg4.c b/drivers/staging/media/meson/vdec/codec_mpeg4.c
index f689c49c5c0c..a9e3d3d81643 100644
--- a/drivers/staging/media/meson/vdec/codec_mpeg4.c
+++ b/drivers/staging/media/meson/vdec/codec_mpeg4.c
@@ -218,7 +218,7 @@ static irqreturn_t codec_mpeg4_threaded_isr(struct amvdec_session *sess)
 		field = V4L2_FIELD_INTERLACED_TB;
 
 	offset = amvdec_read_dos(core, MP4_OFFSET_REG);
-	amvdec_dst_buf_done_idx(sess, buffer_index, offset, field);
+	amvdec_dst_buf_done_idx(sess, buffer_index, offset, field, 0);
 
 	amvdec_write_dos(core, MREG_BUFFEROUT, 0);
 	return IRQ_HANDLED;
diff --git a/drivers/staging/media/meson/vdec/codec_vc1.c b/drivers/staging/media/meson/vdec/codec_vc1.c
index 356e34ff2e35..aa21b2039a77 100644
--- a/drivers/staging/media/meson/vdec/codec_vc1.c
+++ b/drivers/staging/media/meson/vdec/codec_vc1.c
@@ -292,7 +292,7 @@ static irqreturn_t codec_vc1_threaded_isr(struct amvdec_session *sess)
 		amvdec_write_dos(core, VC1_BUFFEROUT, 0);
 		return IRQ_HANDLED;
 	}
-	amvdec_dst_buf_done_idx(sess, buffer_index, offset, field);
+	amvdec_dst_buf_done_idx(sess, buffer_index, offset, field, 0);
 
 	amvdec_write_dos(core, VC1_BUFFEROUT, 0);
 	return IRQ_HANDLED;
-- 
